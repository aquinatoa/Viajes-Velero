DATABASE_URL="file:./dev.db"
# Rutas a los Excel de tarifas que usa el importador CLI (npm run prisma:import-rates).
# Pon aquí las rutas locales de tu equipo; no versiones rutas reales.
ACCOMMODATION_RATES_XLSX="/ruta/local/a/tarifas-alojamientos.xlsx"
ACTIVITY_RATES_XLSX="/ruta/local/a/tarifas-actividades.xlsx"

ZOHO_REGION="eu"
ZOHO_API_DOMAIN="https://www.zohoapis.eu"
ZOHO_ACCOUNTS_DOMAIN="https://accounts.zoho.eu"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_REDIRECT_URI="http://localhost:5173/callback"
ZOHO_CONTACTS_MODULE="Contacts"
ZOHO_ACCOUNTS_MODULE="Accounts"
ZOHO_DEALS_MODULE="Deals"
ZOHO_DEAL_STAGE="Qualification"
ZOHO_DEAL_OPTIONS_FIELD="Description"
ZOHO_APPROVED_OPTION_FIELD=""

# Análisis IA de documentos de inventario.
# Proveedor principal: anthropic (Claude, Messages API vía SDK oficial).
# Modelo por defecto claude-sonnet-4-5; cámbialo en AI_MODEL para usar Haiku u
# otro modelo más adelante. Si AI_PROVIDER no es "anthropic"/"openai" o falta la
# clave correspondiente, el análisis IA funciona en modo mock controlado (no
# llama a ningún proveedor externo y no inventa tarifas).
# No escribas la clave real aquí; ponla solo en tu .env local (no versionado).
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"
# Opcional: proveedor alternativo OpenAI (Responses API).
# AI_PROVIDER="openai"
# AI_API_KEY=""

# Autenticación: admin inicial (se crea al arrancar si no existe). Cámbialo.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Opcional: ruta a un bundle de CA (PEM) si tu red usa un proxy TLS que
# reescribe certificados. Si se define y existe, el backend se relanza con
# NODE_EXTRA_CA_CERTS para poder alcanzar Zoho. Dejar vacío si no aplica.
ZOHO_CA_BUNDLE=

# ─────────────────────────────────────────────────────────────────────────────
# Envío de propuestas al cliente
# ─────────────────────────────────────────────────────────────────────────────
# Cada departamento envía desde SU buzón compartido: es lo único que hace que
# Zoho enganche el correo a la oportunidad (solo vincula lo que pasa por la
# cuenta sincronizada por IMAP). La clave NO es la contraseña del buzón: es una
# "contraseña de aplicación" que se genera en Zoho Mail → Mi cuenta → Seguridad
# → Contraseñas de aplicación, y se puede revocar sin tocar el acceso normal.
#
# MIENTRAS ESTÉN VACÍAS, la app funciona en modo simulación: genera el correo y
# el PDF, los guarda en storage/proposal-deliveries/ y marca la entrega como
# SIMULATED. Rellenar estas cuatro líneas es lo único necesario para encenderlo.
MAIL_GROUPS_ADDRESS=""
MAIL_GROUPS_APP_PASSWORD=""
MAIL_SPORTS_ADDRESS=""
MAIL_SPORTS_APP_PASSWORD=""

# Nombre visible en la bandeja de entrada del cliente.
MAIL_GROUPS_NAME="Oravia Travel Group"
MAIL_SPORTS_NAME="Oravia Sports"

# Servidor de salida. Zoho Europa por defecto (el CRM del cliente es .eu).
MAIL_HOST="smtp.zoho.eu"
MAIL_PORT="465"
MAIL_SECURE="true"

# Dirección por expediente (fase 6): con esto, cada propuesta responde a
# groups+ORV-2026-0184@<dominio> y el correo entrante se cuelga solo del viaje
# correcto. Requiere que el plan de correo admita direcciones con "+".
# Vacío = el "responder a" es el propio buzón y la referencia va en el asunto.
MAIL_PER_TRIP_DOMAIN=""

# Mientras se prueba: si tiene valor, TODOS los correos van a esta dirección en
# vez de al colegio. Dejar vacío en producción.
MAIL_TEST_RECIPIENT=""

# Dirección pública de la app, para el enlace donde el colegio elige su opción.
# Vacío hasta que exista el servidor de Azure: sin esto, el correo sale sin
# enlace y con el PDF solamente.
PUBLIC_BASE_URL=""

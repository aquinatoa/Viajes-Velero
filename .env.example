DATABASE_URL="file:./dev.db"
# Rutas a los Excel de tarifas que usa el importador CLI (npm run prisma:import-rates).
# Pon aquí las rutas locales de tu equipo; no versiones rutas reales.
ACCOMMODATION_RATES_XLSX="/ruta/local/a/tarifas-alojamientos.xlsx"
ACTIVITY_RATES_XLSX="/ruta/local/a/tarifas-actividades.xlsx"

ZOHO_REGION="eu"
ZOHO_API_DOMAIN="https://www.zohoapis.eu"
ZOHO_ACCOUNTS_DOMAIN="https://accounts.zoho.eu"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_REDIRECT_URI="http://localhost:5173/callback"
ZOHO_CONTACTS_MODULE="Contacts"
ZOHO_ACCOUNTS_MODULE="Accounts"
ZOHO_DEALS_MODULE="Deals"
ZOHO_DEAL_STAGE="Qualification"
ZOHO_DEAL_OPTIONS_FIELD="Description"
ZOHO_APPROVED_OPTION_FIELD=""

# Análisis IA de documentos de inventario.
# Proveedor principal: anthropic (Claude, Messages API vía SDK oficial).
# Modelo por defecto claude-sonnet-4-5; cámbialo en AI_MODEL para usar Haiku u
# otro modelo más adelante. Si AI_PROVIDER no es "anthropic"/"openai" o falta la
# clave correspondiente, el análisis IA funciona en modo mock controlado (no
# llama a ningún proveedor externo y no inventa tarifas).
# No escribas la clave real aquí; ponla solo en tu .env local (no versionado).
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"
# Opcional: proveedor alternativo OpenAI (Responses API).
# AI_PROVIDER="openai"
# AI_API_KEY=""

# Autenticación: admin inicial (se crea al arrancar si no existe). Cámbialo.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Opcional: ruta a un bundle de CA (PEM) si tu red usa un proxy TLS que
# reescribe certificados. Si se define y existe, el backend se relanza con
# NODE_EXTRA_CA_CERTS para poder alcanzar Zoho. Dejar vacío si no aplica.
ZOHO_CA_BUNDLE=

# Análisis IA de documentos de inventario.
# Proveedor soportado: openai (Responses API). Si AI_PROVIDER no es "openai" o
# falta AI_API_KEY, el análisis IA funciona en modo mock controlado (no llama a
# ningún proveedor externo y no inventa tarifas).
# No escribas la clave real aquí; ponla solo en tu .env local (no versionado).
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4.1-mini"

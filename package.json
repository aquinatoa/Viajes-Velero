{
  "name": "viajes-velero-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api\" \"vite\"",
    "db:local": "node scripts/dev-db.mjs",
    "db:local:reset": "node scripts/dev-db.mjs --reset",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:documental && npm run test:solicitud && npm run test:pdf && npm run test:crm && npm run test:visibilidad && npm run test:borrado && npm run test:crm-trato && npm run test:correo && npm run test:textos && npm run test:encaje && npm run test:podio && npm run test:preguntas && npm run test:fechas && npm run test:validacion && npm run test:respuestas && npm run test:avance && npm run test:colores && npm run test:siguiente && npm run test:importe && npm run test:aceptada && npm run test:lectura && npm run test:fallo-lectura && npm run test:rejilla && npm run test:viajes && npm run test:plantilla && npm run test:revision-proveedor",
    "test:documental": "node --import tsx tests/documentFlow.test.ts",
    "test:solicitud": "node --import tsx tests/tripRequest.test.ts",
    "test:pdf": "node --import tsx tests/proposalPdf.test.ts",
    "test:borrado": "node --import tsx tests/borrado.test.ts",
    "test:crm-trato": "node --import tsx tests/tratoEnCrm.test.ts",
    "test:correo": "node --import tsx tests/correoEmparejado.test.ts",
    "test:textos": "node --import tsx tests/textoDelAlojamiento.test.ts",
    "test:encaje": "node --import tsx tests/encajeConLaPeticion.test.ts",
    "test:crm": "node --import tsx tests/crmPipeline.test.ts",
    "test:visibilidad": "node --import tsx tests/visibilidad.test.ts",
    "api": "node --import tsx server/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "prisma:import-rates": "node --import tsx prisma/importRates.ts",
    "test:podio": "node --import tsx tests/podio.test.ts",
    "test:preguntas": "node --import tsx tests/loQueFalta.test.ts",
    "test:fechas": "node --import tsx tests/fechas.test.ts",
    "test:validacion": "node --import tsx tests/validacionDeLaPeticion.test.ts",
    "test:respuestas": "node --import tsx tests/interpretarRespuesta.test.ts",
    "test:avance": "node --import tsx tests/avanceDelBorrador.test.ts",
    "test:colores": "node --import tsx tests/coloresDelEmbudo.test.ts",
    "test:siguiente": "node --import tsx tests/siguientePaso.test.ts",
    "test:importe": "node --import tsx tests/importe.test.ts",
    "test:aceptada": "node --import tsx tests/opcionAceptada.test.ts",
    "test:lectura": "node --import tsx tests/lecturaDocumentos.test.ts",
    "test:fallo-lectura": "node --import tsx tests/falloDeLectura.test.ts",
    "test:rejilla": "node --import tsx tests/rejillaDeTarifas.test.ts",
    "test:viajes": "node --import tsx tests/tratosPorDepartamento.test.ts",
    "test:plantilla": "node --import tsx tests/plantillaDeActividades.test.ts",
    "test:revision-proveedor": "node --import tsx tests/revisionPorProveedor.test.ts",
    "lectura:referencia": "node scripts/lectura/exportar-referencia.mjs",
    "lectura:evaluar": "node --import tsx scripts/lectura/evaluar.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@prisma/client": "^6.6.0",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.0.227",
    "pdfkit": "^0.19.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}

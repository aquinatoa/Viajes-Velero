# Los scripts de shell van al servidor: con finales CRLF, Linux responde
# "bad interpreter" y no arrancan. Se guardan y se sacan siempre en LF.
*.sh text eol=lf

# Igual para lo que consume el servidor directamente.
*.service text eol=lf
*.conf    text eol=lf

# Los flujos de GitHub se ejecutan en Linux: un bloque run: con CRLF mete  en
# medio de los comandos.
*.yml  text eol=lf
*.yaml text eol=lf

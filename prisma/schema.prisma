generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id                   String        @id @default(cuid())
  email                String        @unique
  firstName            String
  lastName             String
  fullName             String
  isReturningCustomer  Boolean       @default(false)
  crmContactId         String?
  crmAccountId         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tripRequests         TripRequest[]
}

model TripRequest {
  id                 String         @id @default(cuid())
  clientId           String
  ownerUserId        String?        // quién creó la cotización (para "ver solo lo suyo")
  department         Department?    // Groups / Sports; null si aún no asignado
  opportunityName    String?
  originalMessage    String
  language           String?
  destinationText    String?
  destinationCountry String?
  dateFrom           DateTime?
  dateTo             DateTime?
  participants       Int?
  teachers           Int?
  ageRangeText       String?
  averageAgeText     String?
  groupType          String?
  regimeRequested    String?
  categoryRequested  String?
  requirementsText   String?
  requestStatus      RequestStatus  @default(RECEIVED)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposals          TripProposal[]
}

model Accommodation {
  id                 String                   @id @default(cuid())
  accommodationName  String
  locality           String
  categoryType       String?
  accommodationType  String?
  observations       String?
  conditionsText     String?
  freePolicy         String?
  sourceFile         String?
  sourceDocumentId   String?
  sourceStagingId    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  rates              AccommodationRate[]
  proposalOptions    ProposalAccommodationOption[]

  @@index([sourceDocumentId])
}

model AccommodationRate {
  id                     String         @id @default(cuid())
  accommodationId        String
  rateSource             String?
  year                   Int
  seasonName             String?
  dateFrom               DateTime?
  dateTo                 DateTime?
  minNights              Int?
  boardType              String?
  tariffUnit             String?
  currency               String?
  pvpAmount              Decimal?
  netSaleAmount          Decimal?
  netAzulmarinoAmount    Decimal?
  sourceFile             String?
  sourceSheet            String?
  sourceDocumentId       String?
  sourceStagingId        String?
  accommodation          Accommodation  @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId])
}

model Activity {
  id               String                  @id @default(cuid())
  activityName     String
  supplierName     String?
  locationMain     String?
  durationText     String?
  descriptionText  String?
  sourceFile       String?
  sourceDocumentId String?
  sourceStagingId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  rates            ActivityRate[]
  proposalOptions  ProposalActivityOption[]

  @@index([sourceDocumentId])
}

model ActivityRate {
  id                String     @id @default(cuid())
  activityId        String
  year              Int
  ageLabel          String?
  ageMin            Int?
  ageMax            Int?
  currency          String?
  salePvpAmount     Decimal?
  costNetAmount     Decimal?
  commissionPercent Decimal?
  durationText      String?
  sourceFile        String?
  sourceSheet       String?
  sourceDocumentId  String?
  sourceStagingId   String?
  activity          Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId])
}

model TripProposal {
  id                   String                        @id @default(cuid())
  tripRequestId        String
  versionNumber        Int
  proposalStatus       ProposalStatus               @default(DRAFT)
  approvedOptionNumber Int?
  summaryText          String?
  crmPayloadJson       String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  tripRequest          TripRequest                  @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)
  accommodationOptions ProposalAccommodationOption[]
  activityOptions      ProposalActivityOption[]
  deliveries           ProposalDelivery[]
}

model ProposalAccommodationOption {
  id               String        @id @default(cuid())
  proposalId       String
  accommodationId  String
  optionNumber     Int
  accommodationNameSnapshot String?
  boardType        String?
  dateFrom         DateTime?
  dateTo           DateTime?
  nights           Int?
  participants     Int?
  teachers         Int?
  totalPvpText     String?
  priceBreakdownText String?
  conditionsText   String?
  observationsText String?
  isSelected       Boolean       @default(false)
  proposal         TripProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  accommodation    Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
}

model ProposalActivityOption {
  id                   String       @id @default(cuid())
  proposalId           String
  activityId           String
  optionNumber         Int          @default(1)
  displayOrder         Int
  activityNameSnapshot String
  providerSnapshot     String?
  durationSnapshot     String?
  pvpSnapshot          String?
  descriptionSnapshot  String?
  isSelected           Boolean      @default(true)
  proposal             TripProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  activity             Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model CrmSyncLog {
  id              String      @id @default(cuid())
  entityType      String
  actionType      String
  requestPayload  String?
  responsePayload String?
  syncStatus      SyncStatus
  errorMessage    String?
  createdAt       DateTime    @default(now())
}

enum RequestStatus {
  RECEIVED
  PARSED_WITH_GAPS
  READY_FOR_SEARCH
  PROPOSAL_IN_PROGRESS
  APPROVED
  CRM_READY
}

enum ProposalStatus {
  DRAFT
  READY_FOR_APPROVAL
  APPROVED
}

enum SyncStatus {
  PENDING
  SUCCESS
  ERROR
}
model SourceDocument {
  id                 String   @id @default(cuid())
  documentType       String   @default("SOURCE")
  targetType         String
  originalFileName   String?
  storedFilePath     String?
  fileMimeType       String?
  fileSizeBytes      Int?
  fileHash           String?
  controlName        String
  controlLocation    String?
  controlYear        Int?
  controlCategory    String?
  controlNotes       String?
  status             String   @default("UPLOADED")
  extractionStatus   String   @default("NOT_STARTED")
  requiresOcr        Boolean  @default(false)
  aiConfidence       Decimal?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  processedAt        DateTime?

  extractions            DocumentExtraction[]
  importIssues           ImportIssue[]
  stagingAccommodations  StagingAccommodation[]
  stagingActivities      StagingActivity[]
}

model DocumentExtraction {
  id                String   @id @default(cuid())
  sourceDocumentId  String
  extractionMethod  String
  pageNumber        Int?
  rawText           String?
  rawJson           Json?
  confidenceScore   Decimal?
  createdAt         DateTime @default(now())

  sourceDocument    SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId])
}

model ImportIssue {
  id                String   @id @default(cuid())
  sourceDocumentId  String
  severity          String
  issueType         String
  message           String
  fieldName         String?
  rawValue          String?
  pageNumber        Int?
  resolved          Boolean  @default(false)
  createdAt         DateTime @default(now())

  sourceDocument    SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId])
  @@index([severity])
  @@index([resolved])
}

model StagingAccommodation {
  id                  String   @id @default(cuid())
  sourceDocumentId    String
  accommodationName   String
  providerName        String?
  locality            String?
  province            String?
  country             String?
  categoryType        String?
  accommodationType   String?
  confidenceScore     Decimal?
  reviewStatus        String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sourceDocument      SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  rates               StagingAccommodationRate[]
  adjustments         StagingAccommodationAdjustment[]
  policies            StagingAccommodationPolicy[]
  blackoutDates       StagingAccommodationBlackoutDate[]

  @@index([sourceDocumentId])
  @@index([accommodationName])
  @@index([locality])
  @@index([reviewStatus])
}

model StagingAccommodationRate {
  id                       String   @id @default(cuid())
  stagingAccommodationId   String
  sourceDocumentId         String

  seasonName               String?
  year                     Int?
  dateFrom                 DateTime?
  dateTo                   DateTime?

  boardType                String?
  unitName                 String?
  unitType                 String?
  rateUnit                 String?
  occupancyLabel           String?

  minNights                Int?
  minPax                   Int?
  minUnits                 Int?

  currency                 String   @default("EUR")
  taxIncluded              Boolean?
  pvpAmount                Decimal?
  netAmount                Decimal?
  costAmount               Decimal?
  commissionPercent        Decimal?

  rawText                  String?
  sourcePage               Int?
  confidenceScore          Decimal?
  requiresReview           Boolean  @default(true)
  reviewStatus             String   @default("PENDING")

  stagingAccommodation     StagingAccommodation @relation(fields: [stagingAccommodationId], references: [id], onDelete: Cascade)

  @@index([stagingAccommodationId])
  @@index([sourceDocumentId])
  @@index([year])
  @@index([dateFrom, dateTo])
  @@index([reviewStatus])
}

model StagingAccommodationAdjustment {
  id                       String   @id @default(cuid())
  stagingAccommodationId   String

  adjustmentType            String
  concept                   String
  amountType                String?
  amount                    Decimal?
  appliesPer                String?
  dateFrom                  DateTime?
  dateTo                    DateTime?

  conditionText             String?
  rawText                   String?
  sourcePage                Int?
  confidenceScore           Decimal?
  requiresReview            Boolean @default(true)
  reviewStatus              String  @default("PENDING")

  stagingAccommodation      StagingAccommodation @relation(fields: [stagingAccommodationId], references: [id], onDelete: Cascade)

  @@index([stagingAccommodationId])
  @@index([adjustmentType])
  @@index([reviewStatus])
}

model StagingAccommodationPolicy {
  id                       String   @id @default(cuid())
  stagingAccommodationId   String

  policyType                String
  policyText                String
  structuredJson            Json?
  sourcePage                Int?
  confidenceScore           Decimal?
  requiresReview            Boolean @default(true)
  reviewStatus              String  @default("PENDING")

  stagingAccommodation      StagingAccommodation @relation(fields: [stagingAccommodationId], references: [id], onDelete: Cascade)

  @@index([stagingAccommodationId])
  @@index([policyType])
  @@index([reviewStatus])
}

model StagingAccommodationBlackoutDate {
  id                       String   @id @default(cuid())
  stagingAccommodationId   String

  dateFrom                  DateTime?
  dateTo                    DateTime?
  availabilityStatus        String
  reason                    String?
  rawText                   String?
  sourcePage                Int?
  confidenceScore           Decimal?
  requiresReview            Boolean @default(true)
  reviewStatus              String  @default("PENDING")

  stagingAccommodation      StagingAccommodation @relation(fields: [stagingAccommodationId], references: [id], onDelete: Cascade)

  @@index([stagingAccommodationId])
  @@index([dateFrom, dateTo])
  @@index([availabilityStatus])
  @@index([reviewStatus])
}

model StagingActivity {
  id                  String   @id @default(cuid())
  sourceDocumentId    String

  activityName        String
  supplierName        String?
  locationMain        String?
  province            String?
  country             String?
  activityType        String?
  durationText        String?
  descriptionText     String?

  confidenceScore     Decimal?
  reviewStatus        String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sourceDocument      SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  rates               StagingActivityRate[]
  policies            StagingActivityPolicy[]

  @@index([sourceDocumentId])
  @@index([activityName])
  @@index([supplierName])
  @@index([locationMain])
  @@index([reviewStatus])
}

model StagingActivityRate {
  id                  String   @id @default(cuid())
  stagingActivityId   String

  year                Int?
  seasonName          String?
  dateFrom            DateTime?
  dateTo              DateTime?

  ageLabel            String?
  ageMin              Int?
  ageMax              Int?

  rateUnit            String?
  currency            String   @default("EUR")
  salePvpAmount       Decimal?
  costNetAmount       Decimal?
  commissionPercent   Decimal?

  minPax              Int?
  maxPax              Int?

  durationText        String?
  rawText             String?
  sourcePage          Int?
  confidenceScore     Decimal?
  requiresReview      Boolean  @default(true)
  reviewStatus        String   @default("PENDING")

  stagingActivity     StagingActivity @relation(fields: [stagingActivityId], references: [id], onDelete: Cascade)

  @@index([stagingActivityId])
  @@index([year])
  @@index([dateFrom, dateTo])
  @@index([reviewStatus])
}

model StagingActivityPolicy {
  id                  String   @id @default(cuid())
  stagingActivityId   String

  policyType           String
  policyText           String
  structuredJson       Json?
  sourcePage           Int?
  confidenceScore      Decimal?
  requiresReview       Boolean @default(true)
  reviewStatus         String  @default("PENDING")

  stagingActivity      StagingActivity @relation(fields: [stagingActivityId], references: [id], onDelete: Cascade)

  @@index([stagingActivityId])
  @@index([policyType])
  @@index([reviewStatus])
}
// ----------------------------------------------------------------------------
// Autenticación y control de acceso (operadores internos).
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN       // Administrador global: ve y gestiona todo (todos los departamentos)
  DEPT_ADMIN  // Administrador de departamento: gestiona y ve solo su departamento
  QUOTER      // Cotizador: crea cotizaciones, no edita nada, ve solo las suyas
  USER        // (heredado) cotizador global sin restricción de departamento
}

// Marca / línea de negocio de Oravia. Null = global (todos los departamentos).
enum Department {
  GROUPS
  SPORTS
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  passwordSalt String
  role         UserRole     @default(USER)
  department   Department?  // null = acceso a todos los departamentos (roles globales)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tokens       AuthToken[]
}

model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  role      String?
  action    String
  entity    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Entrega de propuestas al cliente
// ----------------------------------------------------------------------------
// Una "entrega" es cada vez que una propuesta sale hacia el cliente. Se separa
// de TripProposal porque una misma propuesta puede reenviarse (corregida, a otro
// contacto, o porque el primer correo se perdió) y cada envío tiene su propia
// vida: cuándo salió, si lo abrieron, qué opción eligieron y cuándo vence el
// depósito. Es lo que permite que la app -y no la bandeja de entrada- sea quien
// sabe en qué punto está cada viaje.

enum DeliveryStatus {
  DRAFT       // preparada, todavía sin enviar
  SIMULATED   // generada sin credenciales de correo: existe el PDF, no salió
  SENT        // entregada al servidor de correo
  FAILED      // el servidor de correo la rechazó
}

model ProposalDelivery {
  id         String   @id @default(cuid())
  proposalId String
  // Referencia visible para el cliente (ORV-2026-0184). Va en el asunto y en el
  // PDF: es la pista que permite reconocer el hilo aunque Zoho lo cuelgue mal.
  reference  String   @unique
  department Department?

  // Destinatario y contenido enviado (se guarda tal cual salió, no se recalcula)
  recipientEmail String
  recipientName  String?
  replyToEmail   String?   // dirección por expediente, cuando exista (fase 6)
  subject        String
  bodyText       String
  pdfPath        String?   // ruta del PDF generado, dentro de storage/

  status        DeliveryStatus @default(DRAFT)
  failureReason String?
  sentAt        DateTime?
  sentByUserId  String?

  // Vida de la propuesta una vez fuera: la página pública la actualiza sola
  publicToken   String    @unique
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)

  chosenOptionNumber Int?
  chosenAt           DateTime?

  // Reloj del depósito: 40 días desde la aceptación (acuerdo de junio)
  depositDueAt  DateTime?
  depositPaidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal TripProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([status])
  @@index([depositDueAt])
}
